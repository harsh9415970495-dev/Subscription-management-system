# Backend Environment Variables
NODE_ENV=development
PORT=3000
BASE_CURRENCY=INR

# Database Connections (Local Supabase Stack)
# Runtime API: Supavisor Transaction Pooler (port 6543, prepare: false)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6543/postgres?prepare=false
# Migrations & pg-boss: Direct connection (port 5432)
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DB_POOL_MAX=10

# Auth Secrets (backend owned)
JWT_SECRET=super_secret_local_dev_jwt_key_brightloop_12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_local_dev_refresh_key_brightloop_67890
REFRESH_TOKEN_EXPIRES_IN=7d

# Email / SMTP (Mailpit Local)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brightloop System <noreply@brightloop.local>"

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:3000/api/v1
