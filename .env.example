# Backend Environment Variables
NODE_ENV=development
PORT=3000
BASE_CURRENCY=INR

# Database Connections (Local Supabase Stack)
# Runtime API: Supavisor Transaction Pooler (port 6543, prepare: false)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6543/postgres?prepare=false
# Migrations & pg-boss: Direct connection (port 5432)
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DB_POOL_MAX=10

# Auth Secrets (backend owned)
JWT_SECRET=super_secret_local_dev_jwt_key_brightloop_12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_local_dev_refresh_key_brightloop_67890
REFRESH_TOKEN_EXPIRES_IN=7d

# Email Configuration for Production (Render Free Tier blocks outbound SMTP ports 25, 465, 587)
# Solution: Use Resend (100 emails/day FREE via HTTPS API — No SMTP ports needed!)
# 1. Sign up at https://resend.com (takes 30 seconds, no credit card)
# 2. Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_free_resend_api_key_here
EMAIL_FROM="Brightloop System <onboarding@resend.dev>"

# Optional Alternative: Brevo / Sendinblue (300/day free via REST API)
# BREVO_API_KEY=xkeysib-your_brevo_api_key

# Local Dev SMTP (Mailpit - only for local docker development)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brightloop System <noreply@brightloop.local>"

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_URL=http://localhost:3000/api/v1
# In Render Dashboard for Frontend Static Site:
# VITE_API_BASE_URL=https://brightloop-backend.onrender.com/api/v1

