{
  "name": "brightloop-subscription-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter frontend dev",
    "build": "pnpm --recursive run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "postinstall": "npm --prefix backend run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "check:boundaries": "pnpm --filter backend check:boundaries",
    "db:start": "supabase start",
    "db:migrate": "pnpm --filter backend db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
